NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox

# Redis
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Secrets (Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
JWT_SECRET=your-super-secret-jwt-key-minimum-16-chars
ENCRYPTION_KEY=AV2zFL7xAasyXkSOvbxw1sMcA2Lgq+gi7ywWFKqhAoE=

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Slack OAuth (from api.slack.com/apps)
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=https://your-tunnel-url.trycloudflare.com/auth/slack/callback

# Admin Emails (comma-separated, for Bull Board access)
ADMIN_EMAILS=admin@reachinbox.local

# Senders
SENDER_COUNT=3
SMTP_MODE=ethereal                   # ethereal | stub

# Worker
WORKER_CONCURRENCY=5
RUN_WORKER_IN_API=true

# Rate limiting
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
CLAIM_TIMEOUT_MS=120000
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
MAX_LEADS=10000
