{
  "name": "reachinbox-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && node -e \"const fs = require('fs'); const path = require('path'); fs.mkdirSync(path.join('dist', 'redis', 'scripts'), { recursive: true }); fs.copyFileSync(path.join('src', 'redis', 'scripts', 'reserveSlot.lua'), path.join('dist', 'redis', 'scripts', 'reserveSlot.lua'));\"",
    "start": "node dist/server.js",
    "worker": "ts-node-dev --respawn --transpile-only src/worker/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run --reporter=verbose",
    "reindex": "ts-node src/services/reindex.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "demo:seed": "ts-node scripts/demoSeed.ts",
    "demo:fast": "DEMO_MODE=true MIN_DELAY_BETWEEN_EMAILS_MS=500 MAX_EMAILS_PER_HOUR_PER_SENDER=3 ts-node src/server.ts",
    "clean:test-user": "ts-node scripts/deleteTestUser.ts"
  },
  "dependencies": {
    "@bull-board/api": "^5.21.4",
    "@bull-board/express": "^5.21.4",
    "@elastic/elasticsearch": "^8.13.0",
    "@prisma/client": "^5.14.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/uuid": "^9.0.8",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^9.11.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "pino": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "prisma": "^5.14.0",
    "typescript": "^5.5.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "vitest": "^1.6.0"
  }
}
